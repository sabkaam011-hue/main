# ─────────────────────────────────────────────────────────────
# Sabkaam environment variables
# Copy to .env.local for local development. NEVER commit real values.
# Variables prefixed NEXT_PUBLIC_ are exposed to the browser — only put
# public values there.
# ─────────────────────────────────────────────────────────────

# Public URL of the site (used for SEO, payment return URLs and webhooks)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Supabase (Project Settings → API) ──
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SERVER ONLY. Bypasses Row Level Security — never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# ── Login methods (Supabase → Authentication → Providers) ──
NEXT_PUBLIC_AUTH_PHONE_ENABLED=true     # needs an SMS provider (MSG91/Twilio…) configured in Supabase
NEXT_PUBLIC_AUTH_EMAIL_ENABLED=true     # email OTP — easiest for local development
NEXT_PUBLIC_AUTH_GOOGLE_ENABLED=false   # set true after configuring Google OAuth in Supabase

# ── Cashfree Payment Gateway (Merchant Dashboard → Developers → API Keys) ──
# SERVER ONLY. Leave blank to keep payments disabled (the UI explains this; no fake success).
CASHFREE_ENV=sandbox                    # sandbox | production
CASHFREE_CLIENT_ID=
CASHFREE_CLIENT_SECRET=
CASHFREE_API_VERSION=2025-01-01
